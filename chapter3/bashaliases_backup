#git switchの設定
git() {
    if [ "$1" = "switch" ]; then
        command git "$@" && echo git branch && command git branch
    else
        command git "$@"
    fi
}
f() {
  chapter=$(basename "$PWD")
  num=${chapter#chapter}
  printf -v two "%02d" "$1"
  dir="c${num}-${two}-$2"

  mkdir -p "$dir"   # ディレクトリ作成
  cd "$dir"         # その中に移動
}
